{
  "extends": "./tsconfig.json",
  "nodeModulesDir": "auto",
  "workspace": ["tests"],
  "exclude": ["dist"],
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "deno check --unstable-tsgo",
    "check:pindeps": "pindeps --check --dev",
    "tegami": "deno run -A scripts/tegami.ts",
    "test": {
      "dependencies": ["build"],
      "command": "deno test -A src/ tests/ --parallel"
    },
    "test:bun": {
      "dependencies": ["build"],
      "command": "bun test ./tests/bun_test.ts"
    },
    "test:node": {
      "dependencies": ["build"],
      "command": "deno run -A scripts/node-test.ts"
    },
    "publish": "npm publish"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing": "jsr:@std/testing@1.0.20",
    "bun-types": "npm:bun-types@1.3.14",
    "dax": "npm:dax@0.49.0",
    "deno-test": "npm:deno-test@1.0.3",
    "npm": "npm:npm@12.0.2",
    "oxlint": "npm:oxlint@1.77.0",
    "pindeps": "npm:pindeps@0.7.3",
    "tegami": "npm:tegami@1.3.4"
  },
  "lint": false,
  "fmt": {
    "proseWrap": "preserve"
  }
}
